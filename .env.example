# EMIPredict AI - Environment Configuration Example
# Copy this file to .env and adjust variables as required

# MLflow Tracking URI (Default: local SQLite database)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Database Connection URL for Applicant Records (Default: local SQLite file)
# Example for PostgreSQL: postgresql://username:password@localhost:5432/emipredict
DATABASE_URL=sqlite:///database/applicants.db

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application Environment (development, production)
ENV=development
